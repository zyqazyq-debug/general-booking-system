{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booking.invalid/contracts/image-sbom.schema.json",
  "title": "Booking normalized immutable-image SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "image", "source", "packages", "files"],
  "properties": {
    "schema": { "const": "booking.image-sbom/v1" },
    "component": { "enum": ["backend", "gateway"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "not": { "pattern": "(^|:)latest$|@|:[^/]+$" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha"],
      "properties": { "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "purl"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "purl": { "type": "string", "pattern": "^pkg:" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
