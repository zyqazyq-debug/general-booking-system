{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booking.invalid/contracts/image-sbom.schema.json",
  "title": "Booking normalized immutable-image SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "image", "source", "scanner", "packages", "files"],
  "properties": {
    "schema": { "const": "booking.image-sbom/v2" },
    "component": { "enum": ["backend", "gateway", "telegram-egress"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "not": { "pattern": "(^|:)latest$|@|:[^/]+$" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha"],
      "properties": { "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schemaVersion", "nativeDigest", "fileSelection", "fileDigestAlgorithm"],
      "properties": {
        "name": { "const": "syft" },
        "version": { "const": "1.51.1" },
        "schemaVersion": { "type": "string", "pattern": "^16\\.[0-9]+\\.[0-9]+$" },
        "nativeDigest": { "$ref": "#/$defs/digest" },
        "fileSelection": { "const": "all" },
        "fileDigestAlgorithm": { "const": "sha256" }
      }
    },
    "buildInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseImage", "debianMirror", "securityMirror"],
      "properties": {
        "baseImage": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$" },
        "debianMirror": { "$ref": "#/$defs/httpsAptMirror" },
        "securityMirror": { "$ref": "#/$defs/httpsAptMirror" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "purl"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "purl": { "type": "string", "pattern": "^pkg:" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "component": { "const": "telegram-egress" } }, "required": ["component"] },
    "then": { "required": ["buildInputs"] },
    "else": { "not": { "required": ["buildInputs"] } }
  }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "httpsAptMirror": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[A-Za-z0-9._~/-]*[A-Za-z0-9._~-]$" }
  }
}
