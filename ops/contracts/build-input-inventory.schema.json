{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booking.invalid/contracts/build-input-inventory.schema.json",
  "title": "Booking reproducible build-input inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "source", "files"],
  "properties": {
    "schema": { "const": "booking.build-input-inventory/v1" },
    "component": { "enum": ["backend", "gateway", "telegram-egress"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha"],
      "properties": { "gitSha": { "$ref": "#/$defs/gitSha" } }
    },
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["baseImage"],
      "properties": { "baseImage": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$" } }
    },
    "files": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "component": { "const": "backend" } }, "required": ["component"] },
      "then": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "$ref": "#/$defs/backendDockerfile" },
              { "$ref": "#/$defs/backendPackage" },
              { "$ref": "#/$defs/backendLock" }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "component": { "const": "telegram-egress" } }, "required": ["component"] },
      "then": {
        "type": "object",
        "required": ["parameters"],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "$ref": "#/$defs/telegramEgressDockerfile" },
              { "$ref": "#/$defs/telegramEgressEntrypoint" },
              { "$ref": "#/$defs/telegramEgressHealthcheck" },
              { "$ref": "#/$defs/telegramEgressReadback" }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "component": { "const": "gateway" } }, "required": ["component"] },
      "then": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              { "$ref": "#/$defs/frontendDockerfile" },
              { "$ref": "#/$defs/frontendNginxTemplate" },
              { "$ref": "#/$defs/frontendNginxPreprod" },
              { "$ref": "#/$defs/frontendPackage" },
              { "$ref": "#/$defs/frontendLock" }
            ],
            "items": false
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "backendDockerfile": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "backend/Dockerfile" } } }] },
    "backendPackage": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "backend/package.json" } } }] },
    "backendLock": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "backend/package-lock.json" } } }] },
    "frontendDockerfile": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "frontend/Dockerfile" } } }] },
    "frontendNginxTemplate": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "frontend/nginx.release.conf.template" } } }] },
    "frontendNginxPreprod": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "frontend/nginx.preprod.conf" } } }] },
    "frontendPackage": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "frontend/package.json" } } }] },
    "frontendLock": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "frontend/package-lock.json" } } }] },
    "telegramEgressDockerfile": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "ops/telegram-egress/Dockerfile" } } }] },
    "telegramEgressEntrypoint": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "ops/telegram-egress/entrypoint.sh" } } }] },
    "telegramEgressHealthcheck": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "ops/telegram-egress/healthcheck.sh" } } }] },
    "telegramEgressReadback": { "allOf": [{ "$ref": "#/$defs/file" }, { "type": "object", "properties": { "path": { "const": "ops/telegram-egress/readback.sh" } } }] }
  }
}
