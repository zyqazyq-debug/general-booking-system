{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happybooking.uk/contracts/deploy-receipt.schema.json",
  "title": "HappyBooking immutable terminal deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "project", "generation", "fencingEpoch", "operationId", "approvalId", "terminalPhase", "previousReceiptDigest", "terminalStateDigest", "activeIdentity", "evidence", "receiptDigest"],
  "properties": {
    "schema": { "const": "booking.deploy-receipt/v1" },
    "environment": { "enum": ["preprod", "production"] },
    "project": { "enum": ["booking-preprod", "booking-prod"] },
    "generation": { "type": "integer", "minimum": 1 },
    "fencingEpoch": { "type": "integer", "minimum": 1 },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "approvalId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "terminalPhase": { "enum": ["COMMITTED", "ABORT_CANDIDATE", "ROLLED_BACK"] },
    "previousReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
    "terminalStateDigest": { "$ref": "#/$defs/digest" },
    "activeIdentity": { "$ref": "deploy-state.schema.json#/$defs/releaseIdentity" },
    "evidence": { "$ref": "deploy-state.schema.json#/$defs/evidence" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
  }
}
