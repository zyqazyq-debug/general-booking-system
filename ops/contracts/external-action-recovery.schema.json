{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happybooking.uk/contracts/external-action-recovery.schema.json",
  "title": "HappyBooking fenced external action crash recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "project", "action", "actionId", "operationId", "fencingEpoch", "manifestDigest", "releaseIdentity", "requestDigest", "originalReceiptDigest", "recoveredAt", "readbackOutputDigest", "verification", "resources", "receiptDigest"],
  "properties": {
    "schema": { "const": "booking.external-action-recovery/v1" },
    "environment": { "const": "preprod" },
    "project": { "const": "booking-preprod" },
    "action": { "type": "string", "pattern": "^preprod-[a-z-]+$" },
    "actionId": { "$ref": "#/$defs/identifier" },
    "operationId": { "$ref": "#/$defs/identifier" },
    "fencingEpoch": { "type": "integer", "minimum": 1 },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "releaseIdentity": { "$ref": "deploy-state.schema.json#/$defs/releaseIdentity" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "originalReceiptDigest": { "$ref": "#/$defs/digest" },
    "recoveredAt": { "type": "string", "format": "date-time" },
    "readbackOutputDigest": { "$ref": "#/$defs/digest" },
    "verification": { "type": "object" },
    "resources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["resourceId", "previousReceiptDigest", "wasPending"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "previousReceiptDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
          "wasPending": { "type": "boolean" }
        }
      }
    },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
