{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booking.invalid/contracts/registry-attestation-receipt.schema.json",
  "title": "Booking registry signature and attestation pull-back receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "releaseId", "gitSha", "manifestDigest", "image", "evidence", "signer", "verification", "verifiedAt"],
  "properties": {
    "schema": { "const": "booking.registry-attestation-receipt/v1" },
    "component": { "enum": ["backend", "gateway"] },
    "releaseId": { "type": "string", "pattern": "^booking-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[^@]+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbomDigest", "provenanceDigest"],
      "properties": {
        "sbomDigest": { "$ref": "#/$defs/digest" },
        "provenanceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cosignVersion", "publicKeyDigest"],
      "properties": {
        "mode": { "const": "self-managed-key" },
        "cosignVersion": { "const": "3.1.2" },
        "publicKeyDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageSignaturePayloadDigests", "attestations", "pullBackVerified"],
      "properties": {
        "imageSignaturePayloadDigests": { "$ref": "#/$defs/digestSet" },
        "attestations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/sbomAttestation" },
            { "$ref": "#/$defs/provenanceAttestation" }
          ],
          "items": false
        },
        "pullBackVerified": { "const": true }
      }
    },
    "verifiedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "digestSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "baseAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicateType", "evidenceDigest", "statementDigests"],
      "properties": {
        "kind": { "type": "string" },
        "predicateType": { "type": "string", "format": "uri" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "statementDigests": { "$ref": "#/$defs/digestSet" }
      }
    },
    "sbomAttestation": {
      "allOf": [
        { "$ref": "#/$defs/baseAttestation" },
        { "properties": {
          "kind": { "const": "image-sbom" },
          "predicateType": { "const": "https://happybooking.uk/attestations/image-sbom/v2" }
        } }
      ]
    },
    "provenanceAttestation": {
      "allOf": [
        { "$ref": "#/$defs/baseAttestation" },
        { "properties": {
          "kind": { "const": "local-provenance" },
          "predicateType": { "const": "https://happybooking.uk/attestations/local-provenance/v1" }
        } }
      ]
    }
  }
}
