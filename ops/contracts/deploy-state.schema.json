{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happybooking.uk/contracts/deploy-state.schema.json",
  "title": "HappyBooking deployment state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generation", "activeSlot", "activeRelease", "candidateSlot", "candidateRelease",
    "previousSlot", "previousRelease", "phase", "manifestDigest", "operationId", "contractMigrationApplied"
  ],
  "properties": {
    "schema": { "const": "booking.deploy-state/v1" },
    "generation": { "type": "integer", "minimum": 0 },
    "activeSlot": { "enum": ["blue", "green"] },
    "activeRelease": { "type": "string", "minLength": 1 },
    "candidateSlot": { "enum": ["blue", "green", null] },
    "candidateRelease": { "type": ["string", "null"] },
    "previousSlot": { "enum": ["blue", "green", null] },
    "previousRelease": { "type": ["string", "null"] },
    "phase": {
      "enum": [
        "IDLE", "LOCKED", "MANIFEST_VERIFIED", "STAGED", "EXPAND_MIGRATED",
        "CANDIDATE_STARTED", "CANDIDATE_READY", "SINGLETON_TRANSFERRED",
        "SWITCHED", "OBSERVING", "COMMITTED", "ABORT_CANDIDATE",
        "ROLLBACK_PENDING", "ROLLED_BACK", "AUTOMATIC_ROLLBACK_FORBIDDEN", "FAILED"
      ]
    },
    "manifestDigest": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "operationId": { "type": ["string", "null"] },
    "contractMigrationApplied": { "type": "boolean" }
  }
}
