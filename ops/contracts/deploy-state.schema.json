{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happybooking.uk/contracts/deploy-state.schema.json",
  "title": "HappyBooking deployment state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "project", "resources", "runtimeEnvDigest", "generation", "fencingEpoch", "phase", "operationId", "approvalId", "lease", "active", "candidate", "rollback", "evidence", "receiptChainHead", "contractMigrationApplied", "rollbackRehearsalCompleted", "updatedAt"],
  "properties": {
    "schema": { "const": "booking.deploy-state/v2" },
    "environment": { "enum": ["preprod", "production"] },
    "project": { "enum": ["booking-preprod", "booking-prod"] },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["edgeNetwork", "dataNetwork", "databaseRef", "ingressRef"],
      "properties": {
        "edgeNetwork": { "type": "string", "pattern": "^booking-(preprod|prod)-edge$" },
        "dataNetwork": { "type": "string", "pattern": "^booking-(preprod|prod)-data$" },
        "databaseRef": { "type": "string", "pattern": "^database:booking-(preprod|prod)$" },
        "ingressRef": { "type": "string", "pattern": "^ingress:booking-(preprod|prod)$" }
      }
    },
    "runtimeEnvDigest": { "$ref": "#/$defs/digest" },
    "generation": { "type": "integer", "minimum": 0 },
    "fencingEpoch": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["IDLE", "LOCKED", "MANIFEST_VERIFIED", "STAGED", "EXPAND_MIGRATED", "CANDIDATE_STARTED", "CANDIDATE_READY", "SINGLETON_TRANSFERRED", "SWITCHED", "OBSERVING", "COMMITTED", "ROLLBACK_PENDING", "ROLLED_BACK", "AUTOMATIC_ROLLBACK_FORBIDDEN", "FAILED"] },
    "operationId": { "type": ["string", "null"], "minLength": 1 },
    "approvalId": { "type": ["string", "null"], "minLength": 1 },
    "lease": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["leaseId", "holderId", "fencingEpoch", "acquiredAt", "expiresAt"],
          "properties": {
            "leaseId": { "type": "string", "minLength": 1 },
            "holderId": { "type": "string", "minLength": 1 },
            "fencingEpoch": { "type": "integer", "minimum": 1 },
            "acquiredAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "active": { "$ref": "#/$defs/releaseIdentity" },
    "candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releaseIdentity" }] },
    "rollback": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releaseIdentity" }] },
    "evidence": { "$ref": "#/$defs/evidence" },
    "receiptChainHead": { "$ref": "#/$defs/nullableDigest" },
    "contractMigrationApplied": { "type": "boolean" },
    "rollbackRehearsalCompleted": { "type": "boolean" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "releaseIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "releaseId", "gitSha", "manifestDigest"],
      "properties": {
        "slot": { "enum": ["blue", "green"] },
        "releaseId": { "type": "string", "pattern": "^booking-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}$" },
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "nullableDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineReceiptDigest", "expandMigrationReceiptDigest", "stageReceiptDigest", "candidateProbeDigest", "rollbackPreSwitchProbeDigest", "singletonTransferReceiptDigest", "switchReceiptDigest", "webhookReceiptDigest", "observationReceiptDigest", "rollbackReceiptDigest", "rollbackSingletonTransferReceiptDigest", "rolledBackProbeDigest"],
      "properties": {
        "baselineReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "expandMigrationReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "stageReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "candidateProbeDigest": { "$ref": "#/$defs/nullableDigest" },
        "rollbackPreSwitchProbeDigest": { "$ref": "#/$defs/nullableDigest" },
        "singletonTransferReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "switchReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "webhookReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "observationReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "rollbackReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "rollbackSingletonTransferReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "rolledBackProbeDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    }
  }
}
