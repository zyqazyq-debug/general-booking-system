{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booking.invalid/contracts/registry-evidence-predicate.schema.json",
  "title": "Booking registry evidence predicate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "component", "releaseId", "gitSha", "manifestDigest", "image", "evidence"],
  "properties": {
    "schema": { "const": "booking.registry-evidence-predicate/v1" },
    "kind": { "enum": ["image-sbom", "local-provenance"] },
    "component": { "enum": ["backend", "gateway", "telegram-egress"] },
    "releaseId": { "type": "string", "pattern": "^booking-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[^@]+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "document"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "document": { "type": "object", "minProperties": 1 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
