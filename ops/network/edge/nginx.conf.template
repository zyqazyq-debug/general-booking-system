log_format booking_json escape=json
  '{"time":"$time_iso8601","request_id":"$request_id","remote_addr":"$remote_addr",'
  '"method":"$request_method","uri":"$uri","status":$status,'
  '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

map $http_x_forwarded_proto $booking_forwarded_proto {
  default $scheme;
  http http;
  https https;
}

map $http_upgrade $booking_connection_upgrade {
  default upgrade;
  '' close;
}

include /etc/nginx/upstreams/active.conf;

server {
  listen 8080;
  server_name _;

  set_real_ip_from ${BOOKING_TRUSTED_PROXY_CIDR};
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  access_log /dev/stdout booking_json;
  error_log /dev/stderr warn;

  location = /telegram/webhook {
    proxy_pass http://booking_active;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $booking_forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $booking_connection_upgrade;
  }

  location / {
    proxy_pass http://booking_active;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $booking_forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $booking_connection_upgrade;
  }
}
