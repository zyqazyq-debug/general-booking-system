recover_runtime_lock() {
  runtime_expected_digest=$1
  [ ! -L "$RUNTIME_LOCK" ] && [ ! -d "$RUNTIME_LOCK" ] || fail
  runtime_conflicts_absent || fail
  runtime_txn="$RUNTIME_TXN_PREFIX-${runtime_expected_digest#sha256:}"
  runtime_trusted_item "$runtime_txn" directory
  runtime_txn_intent="$runtime_txn/intent.json"
  if [ -e "$RUNTIME_LOCK" ]; then runtime_intent_links=2; else runtime_intent_links=1; fi
  read_runtime_lock_at "$runtime_txn_intent" "$runtime_intent_links"
  [ "$runtime_lock_digest" = "$runtime_expected_digest" ] || fail
  if [ -e "$runtime_txn/final.json" ]; then
    path_absent "$RUNTIME_LOCK" || fail
    read_runtime_final
    prove_runtime_absent "$runtime_final_container"
    printf '%s\n' RUNTIME_LOCK_ALREADY_RECOVERED
    return
  else path_absent "$runtime_txn/final.json" || fail; fi
  runtime_owner_is_live && fail
  runtime_recovery_owner='absent'
  runtime_recovery_create='absent'
  runtime_recovery_completion='absent'
  runtime_recovery_exit='unknown'
  runtime_recovered_id='absent'
  runtime_container_present='false'

  if read_runtime_create; then
    runtime_recovery_create=$runtime_create_digest
    runtime_recovered_id=$runtime_created_id
  else
    path_absent "$runtime_txn/create.json" || fail
    path_absent "$runtime_txn/owner.json" && path_absent "$runtime_txn/completion-intent.json" || fail
    [ -z "$(runtime_label_ids "label=uk.happybooking.runtime-lock-digest=$runtime_lock_digest")" ] || fail
    [ -z "$(runtime_name_ids)" ] || fail
  fi
  if [ "$runtime_recovery_create" != 'absent' ]; then
    if read_runtime_owner_record; then
      runtime_recovery_owner=$runtime_owner_digest
      [ "$runtime_bound_container" = "$runtime_recovered_id" ] || fail
      if read_completion_intent; then
        runtime_recovery_completion=$runtime_completion_digest
        runtime_recovery_exit=$runtime_container_exit_code
      else path_absent "$runtime_txn/completion-intent.json" || fail; fi
    else
      path_absent "$runtime_txn/owner.json" && path_absent "$runtime_txn/completion-intent.json" || fail
    fi
  fi

  runtime_exact_label_id=$(runtime_label_ids "label=uk.happybooking.runtime-lock-digest=$runtime_lock_digest")
  if [ "$runtime_recovered_id" = 'absent' ]; then
    [ -z "$runtime_exact_label_id" ] || fail
    [ -z "$(runtime_name_ids)" ] || fail
  else
    [ -z "$runtime_exact_label_id" ] || [ "$runtime_exact_label_id" = "$runtime_recovered_id" ] || fail
    read_runtime_bound_container_twice "$runtime_recovered_id"
    if [ "$runtime_bound_first_id" != 'absent' ]; then
      [ "$runtime_exact_label_id" = "$runtime_recovered_id" ] || fail
      [ "$runtime_container_running" = 'false' ] || fail
      runtime_container_present='true'
      if [ "$runtime_container_status" = 'exited' ]; then
        if [ "$runtime_recovery_exit" = 'unknown' ]; then runtime_recovery_exit=$runtime_container_exit_code; fi
        [ "$runtime_recovery_exit" = "$runtime_container_exit_code" ] || fail
      else
        [ "$runtime_container_status" = 'created' ] && [ "$runtime_recovery_exit" = 'unknown' ] || fail
      fi
    else
      prove_runtime_absent "$runtime_recovered_id"
      if [ -e "$runtime_txn/recovery-intent.json" ]; then
        runtime_recovery_exit=$(runtime_json_string "$runtime_txn/recovery-intent.json" observedExitCode)
        case "$runtime_recovery_exit" in unknown|*[!0-9]*) [ "$runtime_recovery_exit" = 'unknown' ] || fail ;; esac
      fi
    fi
  fi

  runtime_derived_id=$runtime_recovered_id
  runtime_derived_create=$runtime_recovery_create
  runtime_derived_owner=$runtime_recovery_owner
  runtime_derived_exit=$runtime_recovery_exit
  if read_recovery_intent; then
    [ "$runtime_recovered_id" = "$runtime_derived_id" ] && [ "$runtime_recovery_create" = "$runtime_derived_create" ] || fail
    [ "$runtime_recovery_owner" = "$runtime_derived_owner" ] && [ "$runtime_recovery_exit" = "$runtime_derived_exit" ] || fail
  else
    publish_recovery_intent
  fi
  # RUNTIME_TEST_CHECKPOINT recovery-intent-published
  if [ "$runtime_container_present" = 'true' ]; then
    read_runtime_bound_container_twice "$runtime_recovered_id"
    [ "$runtime_bound_first_id" = "$runtime_recovered_id" ] && [ "$runtime_container_running" = 'false' ] || fail
    docker_host container rm "$runtime_recovered_id" >/dev/null || fail
  fi
  prove_runtime_absent "$runtime_recovered_id"
  # RUNTIME_TEST_CHECKPOINT container-removed
  runtime_owner_is_live && fail
  runtime_conflicts_absent || fail
  prove_runtime_absent "$runtime_recovered_id"
  if [ -e "$RUNTIME_LOCK" ]; then runtime_allow_live='false'; remove_runtime_lock_link; else path_absent "$RUNTIME_LOCK" || fail; fi
  runtime_final_action='recovery'; runtime_final_completion=$runtime_recovery_completion; runtime_final_container=$runtime_recovered_id
  runtime_final_exit=$runtime_recovery_exit; runtime_final_owner=$runtime_recovery_owner; runtime_final_recovery=$runtime_recovery_id
  runtime_final_recovery_intent=$runtime_recovery_intent_digest
  if [ "$runtime_final_exit" = 'unknown' ]; then runtime_final_business='unknown'; elif [ "$runtime_final_exit" = '0' ]; then runtime_final_business='succeeded'; else runtime_final_business='failed'; fi
  if [ "$runtime_container_present" = 'true' ]; then runtime_final_result='removed'; else runtime_final_result='absent'; fi
  prove_runtime_absent "$runtime_recovered_id"
  publish_runtime_final
  printf '%s\n' RUNTIME_LOCK_RECOVERED
}

