  case "$seen" in *" $key "*) fail ;; esac
  [ "$#" -gt 0 ] || fail
  value=$1
  shift
  [ -n "$value" ] || fail
  case "$value" in --*|*[!A-Za-z0-9._:@-]*) fail ;; esac
  seen="$seen$key "
  case "$key" in
    environment) environment=$value ;;
    project) project=$value ;;
    execute) execute=$value ;;
    action) action=$value ;;
    identity) identity=$value ;;
    release-id) release_id=$value ;;
    operation-id) operation_id=$value ;;
    expected-backup-digest) expected_backup_digest=$value ;;
    approval-id) approval_id=$value ;;
    expected-generation) expected_generation=$value ;;
    expected-fencing-epoch) expected_fencing_epoch=$value ;;
    manifest-digest) manifest_digest=$value ;;
    lease-id) lease_id=$value ;;
    holder-id) holder_id=$value ;;
  esac
  # Values have already been restricted to a shell-inert alphabet. This string
  # only preserves validated pairs until the final positional vector is rebuilt.
  forwarded="$forwarded $option $value"
done

[ "$environment" = 'preprod' ] || fail
