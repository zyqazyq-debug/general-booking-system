#!/bin/sh
set -eu
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
IFS=' '
export PATH

IMAGE='node@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5'
HOST_DOCKER='/var/packages/ContainerManager/target/usr/bin/docker'
HOST_COMPOSE='/var/packages/ContainerManager/target/usr/bin/docker-compose'
STATE_ROOT='/var/lib/happybooking'
PREPROD_ROOT='/volume1/happybooking/booking-preprod'
CONTROL_ROOT='/usr/local/libexec/happybooking/control-plane'
CONTROL_ENV='/etc/happybooking/secrets/booking-preprod-control-plane.env'
EVIDENCE_ROOT='/volume1/happybooking/booking-preprod/.g4'
COSIGN='/usr/local/bin/cosign'
TRUST_ROOT='/etc/happybooking/trust'
LEGACY_RELEASE='booking-20260908T202714Z-317be4dec675'
INSTALL_LOCK='/usr/local/libexec/.happybooking-control-plane-install.lock'
INSTALL_JOURNAL='/usr/local/libexec/.happybooking-control-plane-install.journal.json'
RUNTIME_LOCK='/usr/local/libexec/.happybooking-control-plane-runtime.lock'
MIGRATION_LOCK='/usr/local/libexec/.happybooking-legacy-active-migration.lock'
MIGRATION_JOURNAL='/usr/local/libexec/.happybooking-legacy-active-migration.journal.json'
RUNTIME_TXN_PREFIX='/usr/local/libexec/.happybooking-control-plane-runtime-txn'
HOST_DOCKER_CONFIG='/usr/local/libexec/happybooking/control-plane/ops/release/.host-docker-empty'
PROC_ROOT='/proc'
BOOT_ID_PATH='/proc/sys/kernel/random/boot_id'
SHA256SUM='/usr/bin/sha256sum'
STAT='/usr/bin/stat'
READLINK='/usr/bin/readlink'
SYNC='/usr/bin/sync'
LINK='/usr/bin/link'
AWK='/bin/awk'
CAT='/bin/cat'
CHMOD='/bin/chmod'
DIRNAME='/usr/bin/dirname'
ID='/usr/bin/id'
MKDIR='/bin/mkdir'
RMDIR='/bin/rmdir'
SED='/bin/sed'
UNLINK='/usr/bin/unlink'
EXPECTED_UID='0'
EXPECTED_GID='0'

fail() {
  printf '%s\n' "booking-preprod control-plane launcher rejected the request" >&2
  exit 64
}

path_absent() {
  [ ! -e "$1" ] && [ ! -L "$1" ]
}

[ -z "${BOOKING_CONTROL_PLANE_RUNTIME_LOCK_TEST_ROOT:-}" ] || fail
[ -z "${BOOKING_CONTROL_PLANE_RUNTIME_LOCK_TEST_EXECUTE:-}" ] || fail
[ -z "${BOOKING_CONTROL_PLANE_RUNTIME_LOCK_TEST_STAT:-}" ] || fail
[ -z "${BOOKING_CONTROL_PLANE_RUNTIME_LOCK_TEST_TRUST:-}" ] || fail
[ -z "${BOOKING_CONTROL_PLANE_RUNTIME_LOCK_TEST_CRASH_AT:-}" ] || fail

DOCKER_HOST='unix:///var/run/docker.sock'
DOCKER_CONFIG=$HOST_DOCKER_CONFIG
HOME='/root'
unset DOCKER_CONTEXT DOCKER_TLS DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_API_VERSION DOCKER_AUTH_CONFIG DOCKER_CUSTOM_HEADERS
unset DOCKER_CONTENT_TRUST DOCKER_CONTENT_TRUST_SERVER DOCKER_DEFAULT_PLATFORM DOCKER_HIDE_LEGACY_COMMANDS DOCKER_SCAN_SUGGEST DOCKER_CLI_HINTS BUILDKIT_HOST
unset COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_PATH_SEPARATOR COMPOSE_ENV_FILES COMPOSE_DISABLE_ENV_FILE COMPOSE_PARALLEL_LIMIT COMPOSE_ANSI COMPOSE_STATUS_STDOUT COMPOSE_PROGRESS
unset LD_PRELOAD LD_LIBRARY_PATH
export DOCKER_HOST DOCKER_CONFIG HOME

docker_host() {
  "$HOST_DOCKER" --host unix:///var/run/docker.sock --config "$HOST_DOCKER_CONFIG" "$@"
}

runtime_start_ticks() {
  runtime_pid=$1
  runtime_stat_path="$PROC_ROOT/$runtime_pid/stat"
  [ -r "$runtime_stat_path" ] || return 1
  runtime_stat=$("$CAT" "$runtime_stat_path") || return 1
  case "$runtime_stat" in *') '*) runtime_stat=${runtime_stat##*) } ;; *) return 1 ;; esac
  set -- $runtime_stat
  [ "$#" -ge 20 ] || return 1
  shift 19
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$1"
}

runtime_sha256() {
  "$SHA256SUM" | "$AWK" '{printf "sha256:%s", $1}'
}

runtime_trusted_item() {
  runtime_item=$1
  runtime_kind=$2
  [ -e "$runtime_item" ] && [ ! -L "$runtime_item" ] || fail
  [ "$("$READLINK" -f "$runtime_item")" = "$runtime_item" ] || fail
  runtime_metadata=$("$STAT" --format='%u %g %a %h' "$runtime_item") || fail
  set -- $runtime_metadata
  [ "$1" = "$EXPECTED_UID" ] && [ "$2" = "$EXPECTED_GID" ] || fail
  case "$runtime_kind" in
    directory)
      [ -d "$runtime_item" ] || fail
      case "$3" in 500|700) ;; *) fail ;; esac
      ;;
    file)
      [ -f "$runtime_item" ] || fail
      [ "$3" = '400' ] || fail
      ;;
    *) fail ;;
  esac
}

runtime_trusted_directory() {
  runtime_directory=$1
  [ -d "$runtime_directory" ] && [ ! -L "$runtime_directory" ] || fail
  runtime_metadata=$("$STAT" --format='%u %g %a' "$runtime_directory") || fail
  set -- $runtime_metadata
  [ "$1" = "$EXPECTED_UID" ] || fail
  case "$3" in
    [0-7][0-7][0-7]) ;;
    *) fail ;;
  esac
  runtime_non_owner_mode=${3#?}
  case "$runtime_non_owner_mode" in *[2367]*) fail ;; esac
}

runtime_trusted_executable() {
  runtime_executable=$1
  [ -f "$runtime_executable" ] && [ ! -L "$runtime_executable" ] && [ -x "$runtime_executable" ] || fail
  runtime_metadata=$("$STAT" --format='%u %g %a %h' "$runtime_executable") || fail
  set -- $runtime_metadata
  [ "$1" = "$EXPECTED_UID" ] && [ "$4" = '1' ] || fail
  case "$3" in
    [0-7][0-7][0-7]) ;;
    *) fail ;;
  esac
  runtime_non_owner_mode=${3#?}
  runtime_owner_mode=${3%$runtime_non_owner_mode}
  case "$runtime_owner_mode" in 1|3|5|7) ;; *) fail ;; esac
  case "$runtime_non_owner_mode" in *[2367]*) fail ;; esac
}

runtime_trusted_resolved_chain() {
  runtime_chain_item=$1
  while [ "$runtime_chain_item" != '/' ]; do
    runtime_chain_item=$("$DIRNAME" "$runtime_chain_item") || fail
    runtime_trusted_directory "$runtime_chain_item"
  done
}

runtime_trusted_tool() {
  runtime_tool_alias=$1
  case "$runtime_tool_alias" in /*) ;; *) fail ;; esac
  runtime_tool_resolved=$("$READLINK" -f "$runtime_tool_alias") || fail
  case "$runtime_tool_resolved" in /*) ;; *) fail ;; esac
  runtime_trusted_executable "$runtime_tool_resolved"
  runtime_trusted_resolved_chain "$runtime_tool_resolved"
  runtime_alias_parent=$("$READLINK" -f "$("$DIRNAME" "$runtime_tool_alias")") || fail
  runtime_trusted_directory "$runtime_alias_parent"
  runtime_trusted_resolved_chain "$runtime_alias_parent"
}

runtime_trusted_recovery_environment() {
  [ "$("$ID" -u)" = "$EXPECTED_UID" ] || fail
  for runtime_tool in "$SHA256SUM" "$STAT" "$READLINK" "$SYNC" "$LINK" "$AWK" "$CAT" "$CHMOD" "$DIRNAME" "$ID" "$MKDIR" "$RMDIR" "$SED" "$UNLINK" "$HOST_DOCKER"; do
    runtime_trusted_tool "$runtime_tool"
  done
  runtime_lock_parent=$("$READLINK" -f "$("$DIRNAME" "$RUNTIME_LOCK")") || fail
  runtime_trusted_directory "$runtime_lock_parent"
  runtime_trusted_resolved_chain "$runtime_lock_parent"
  path_absent "$HOST_DOCKER_CONFIG" || fail
  runtime_config_parent=$("$READLINK" -f "$("$DIRNAME" "$HOST_DOCKER_CONFIG")") || fail
  runtime_trusted_directory "$runtime_config_parent"
  runtime_trusted_resolved_chain "$runtime_config_parent"
}

runtime_conflicts_absent() {
  path_absent "$HOST_DOCKER_CONFIG" &&
    path_absent "$INSTALL_LOCK" && path_absent "$INSTALL_JOURNAL" &&
    path_absent "$MIGRATION_LOCK" && path_absent "$MIGRATION_JOURNAL"
}

runtime_lock_body() {
  printf '%s' "{\"bootId\":\"$runtime_owner_boot_id\",\"containerIdentity\":\"$runtime_owner_container\",\"imageDigest\":\"$runtime_owner_image\",\"pid\":$runtime_owner_pid,\"requestDigest\":\"$runtime_owner_request_digest\",\"schema\":\"booking.preprod-runtime-lock-intent/v2\",\"startTicks\":\"$runtime_owner_start_ticks\"}"
}

runtime_lock_document() {
  printf '%s\n' "{\"bootId\":\"$runtime_owner_boot_id\",\"containerIdentity\":\"$runtime_owner_container\",\"imageDigest\":\"$runtime_owner_image\",\"lockDigest\":\"$runtime_lock_digest\",\"pid\":$runtime_owner_pid,\"requestDigest\":\"$runtime_owner_request_digest\",\"schema\":\"booking.preprod-runtime-lock-intent/v2\",\"startTicks\":\"$runtime_owner_start_ticks\"}"
}

runtime_json_string() {
  runtime_json_file=$1
  runtime_json_field=$2
  runtime_json_value=$("$SED" -n "s/.*\"$runtime_json_field\":\"\([^\"]*\)\".*/\1/p" "$runtime_json_file")
  [ -n "$runtime_json_value" ] || fail
  printf '%s' "$runtime_json_value"
}

runtime_file_digest() {
  "$SHA256SUM" "$1" | "$AWK" '{printf "sha256:%s", $1}'
}

runtime_exact_file() {
  runtime_exact_path=$1
  runtime_exact_document=$2
  runtime_exact_links=$3
  runtime_trusted_item "$runtime_exact_path" file
  runtime_exact_metadata=$("$STAT" --format='%h' "$runtime_exact_path") || fail
  [ "$runtime_exact_metadata" = "$runtime_exact_links" ] || fail
  runtime_exact_expected=$(printf '%s\n' "$runtime_exact_document" | runtime_sha256)
  [ "$(runtime_file_digest "$runtime_exact_path")" = "$runtime_exact_expected" ] || fail
}

runtime_publish_stage_inventory() {
  runtime_publish_entries=0
  for runtime_publish_entry in "$runtime_publish_stage"/* "$runtime_publish_stage"/.[!.]* "$runtime_publish_stage"/..?*; do
    [ -e "$runtime_publish_entry" ] || [ -L "$runtime_publish_entry" ] || continue
    runtime_publish_entries=$((runtime_publish_entries + 1))
    [ "$runtime_publish_entry" = "$runtime_publish_source" ] || fail
  done
  if [ -e "$runtime_publish_source" ] || [ -L "$runtime_publish_source" ]; then
    [ "$runtime_publish_entries" -eq 1 ] || fail
  else
    [ "$runtime_publish_entries" -eq 0 ] || fail
  fi
}

runtime_publish_partial_source() {
  [ -f "$runtime_publish_source" ] && [ ! -L "$runtime_publish_source" ] || return 1
  [ "$("$READLINK" -f "$runtime_publish_source")" = "$runtime_publish_source" ] || return 1
  runtime_publish_metadata=$("$STAT" --format='%u %g %a %h' "$runtime_publish_source") || return 1
  set -- $runtime_publish_metadata
  [ "$1" = "$EXPECTED_UID" ] && [ "$2" = "$EXPECTED_GID" ] && [ "$4" = '1' ] || return 1
  runtime_publish_mode=$3
  case "$runtime_publish_mode" in 400|600) ;; *) return 1 ;; esac
}

runtime_publish_record() {
  runtime_publish_path=$1
  runtime_publish_document=$2
  runtime_publish_parent=$("$DIRNAME" "$runtime_publish_path")
  runtime_publish_digest=$(printf '%s\n' "$runtime_publish_document" | runtime_sha256)
  runtime_publish_stage="$runtime_publish_path.publish-${runtime_publish_digest#sha256:}"
  runtime_publish_source="$runtime_publish_stage/record.json"

  if [ -e "$runtime_publish_path" ] && [ ! -e "$runtime_publish_stage" ]; then
    runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 1
    return
  fi

  if [ -e "$runtime_publish_stage" ]; then
    runtime_trusted_item "$runtime_publish_stage" directory
    runtime_publish_stage_inventory
    if [ -e "$runtime_publish_path" ]; then
      if [ -e "$runtime_publish_source" ]; then
        runtime_exact_file "$runtime_publish_source" "$runtime_publish_document" 2
        runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 2
        [ "$("$STAT" --format='%d:%i' "$runtime_publish_source")" = "$("$STAT" --format='%d:%i' "$runtime_publish_path")" ] || fail
        sync_runtime_path "$runtime_publish_parent"
        "$UNLINK" "$runtime_publish_source" || fail
        "$RMDIR" "$runtime_publish_stage" || fail
        sync_runtime_path "$runtime_publish_parent"
        runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 1
        return
      else
        runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 1
        "$RMDIR" "$runtime_publish_stage" || fail
        sync_runtime_path "$runtime_publish_parent"
        return
      fi
    elif [ -e "$runtime_publish_source" ]; then
      runtime_publish_partial_source || fail
      if [ "$(runtime_file_digest "$runtime_publish_source")" != "$runtime_publish_digest" ]; then
        "$UNLINK" "$runtime_publish_source" || fail
        "$RMDIR" "$runtime_publish_stage" || fail
        sync_runtime_path "$runtime_publish_parent"
      fi
    else
      "$RMDIR" "$runtime_publish_stage" || fail
      sync_runtime_path "$runtime_publish_parent"
    fi
  fi

  if [ ! -e "$runtime_publish_stage" ]; then
    "$MKDIR" -m 700 "$runtime_publish_stage" || fail
    # RUNTIME_TEST_CHECKPOINT record-stage-created
    ( umask 077; printf '%s\n' "$runtime_publish_document" > "$runtime_publish_source" ) || fail
    # RUNTIME_TEST_CHECKPOINT record-source-written
  fi

  runtime_publish_stage_inventory
  runtime_publish_partial_source || fail
  [ "$(runtime_file_digest "$runtime_publish_source")" = "$runtime_publish_digest" ] || fail
  if [ "$runtime_publish_mode" = '600' ]; then "$CHMOD" 400 "$runtime_publish_source" || fail; fi
  # RUNTIME_TEST_CHECKPOINT record-source-chmodded
  runtime_exact_file "$runtime_publish_source" "$runtime_publish_document" 1
  sync_runtime_path "$runtime_publish_source"
  # RUNTIME_TEST_CHECKPOINT record-source-synced
  sync_runtime_path "$runtime_publish_stage"
  # RUNTIME_TEST_CHECKPOINT record-stage-synced

  if [ ! -e "$runtime_publish_path" ]; then
    "$LINK" "$runtime_publish_source" "$runtime_publish_path" || fail
    # RUNTIME_TEST_CHECKPOINT record-linked
    sync_runtime_path "$runtime_publish_parent"
    # RUNTIME_TEST_CHECKPOINT record-parent-synced
  fi
  runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 2
  runtime_publish_source_inode=$("$STAT" --format='%d:%i' "$runtime_publish_source") || fail
  runtime_publish_final_inode=$("$STAT" --format='%d:%i' "$runtime_publish_path") || fail
  [ "$runtime_publish_source_inode" = "$runtime_publish_final_inode" ] || fail
  "$UNLINK" "$runtime_publish_source" || fail
  # RUNTIME_TEST_CHECKPOINT record-source-unlinked
  "$RMDIR" "$runtime_publish_stage" || fail
  sync_runtime_path "$runtime_publish_parent"
  runtime_exact_file "$runtime_publish_path" "$runtime_publish_document" 1
}

read_runtime_lock_at() {
  runtime_lock_file=$1
  runtime_lock_links=$2
  runtime_owner_boot_id=$(runtime_json_string "$runtime_lock_file" bootId)
  runtime_owner_container=$(runtime_json_string "$runtime_lock_file" containerIdentity)
  runtime_owner_image=$(runtime_json_string "$runtime_lock_file" imageDigest)
  runtime_lock_digest=$(runtime_json_string "$runtime_lock_file" lockDigest)
  runtime_owner_request_digest=$(runtime_json_string "$runtime_lock_file" requestDigest)
  runtime_owner_start_ticks=$(runtime_json_string "$runtime_lock_file" startTicks)
  runtime_owner_pid=$("$SED" -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$runtime_lock_file")
  case "$runtime_owner_boot_id" in ????????-????-????-????-????????????) ;; *) fail ;; esac
  case "$runtime_owner_boot_id" in *[!0-9a-f-]*) fail ;; esac
  case "$runtime_owner_container" in booking-preprod-control-plane|booking-preprod-lock-recovery) ;; *) fail ;; esac
  [ "$runtime_owner_image" = "$IMAGE" ] || fail
  case "$runtime_lock_digest:$runtime_owner_request_digest" in sha256:????????????????????????????????????????????????????????????????:sha256:????????????????????????????????????????????????????????????????) ;; *) fail ;; esac
  case "$runtime_owner_pid:$runtime_owner_start_ticks" in *[!0-9:]*) fail ;; esac
  [ -n "$runtime_owner_pid" ] && [ -n "$runtime_owner_start_ticks" ] || fail
  runtime_request_hex=${runtime_owner_request_digest#sha256:}
  [ "${#runtime_request_hex}" -eq 64 ] || fail
  case "$runtime_request_hex" in *[!0-9a-f]*) fail ;; esac
  [ "$(runtime_lock_body | runtime_sha256)" = "$runtime_lock_digest" ] || fail
  runtime_lock_doc=$(runtime_lock_document)
  runtime_exact_file "$runtime_lock_file" "$runtime_lock_doc" "$runtime_lock_links"
  runtime_txn="$RUNTIME_TXN_PREFIX-${runtime_lock_digest#sha256:}"
}

read_runtime_lock() {
  read_runtime_lock_at "$RUNTIME_LOCK" 2
  runtime_trusted_item "$runtime_txn" directory
  runtime_txn_intent="$runtime_txn/intent.json"
  runtime_exact_file "$runtime_txn_intent" "$runtime_lock_doc" 2
  [ "$("$STAT" --format='%d:%i' "$RUNTIME_LOCK")" = "$("$STAT" --format='%d:%i' "$runtime_txn_intent")" ] || fail
}

runtime_owner_is_live() {
  runtime_current_boot=$("$CAT" "$BOOT_ID_PATH") || fail
  case "$runtime_current_boot" in ????????-????-????-????-????????????) ;; *) fail ;; esac
  case "$runtime_current_boot" in *[!0-9a-f-]*) fail ;; esac
  [ "$runtime_current_boot" = "$runtime_owner_boot_id" ] || return 1
  [ -d "$PROC_ROOT/$runtime_owner_pid" ] || return 1
  [ -r "$PROC_ROOT/$runtime_owner_pid/stat" ] || { [ ! -d "$PROC_ROOT/$runtime_owner_pid" ] && return 1; fail; }
  runtime_current_ticks=$(runtime_start_ticks "$runtime_owner_pid") || { [ ! -d "$PROC_ROOT/$runtime_owner_pid" ] && return 1; fail; }
  [ "$runtime_current_ticks" = "$runtime_owner_start_ticks" ]
}

runtime_docker_record() {
  runtime_reference=$1
  docker_host container inspect --format '{{.Id}}|{{.Name}}|{{.State.Status}}|{{.State.Running}}|{{.State.ExitCode}}|{{.Config.Image}}|{{index .Config.Labels "uk.happybooking.runtime-lock-digest"}}' "$runtime_reference" 2>/dev/null
}

runtime_docker_daemon() {
  runtime_server_version=$(docker_host version --format '{{.Server.Version}}' 2>/dev/null) || fail
  [ -n "$runtime_server_version" ] || fail
}

runtime_validate_container_record() {
  runtime_first=$1
  runtime_container_id=${runtime_first%%|*}
  runtime_remainder=${runtime_first#*|}; runtime_container_name=${runtime_remainder%%|*}
  runtime_remainder=${runtime_remainder#*|}; runtime_container_status=${runtime_remainder%%|*}
  runtime_remainder=${runtime_remainder#*|}; runtime_container_running=${runtime_remainder%%|*}
  runtime_remainder=${runtime_remainder#*|}; runtime_container_exit_code=${runtime_remainder%%|*}
  runtime_remainder=${runtime_remainder#*|}; runtime_container_image=${runtime_remainder%%|*}
  runtime_container_label=${runtime_remainder#*|}
  case "$runtime_container_id" in *[!0-9a-f]*|'') fail ;; esac
  [ "${#runtime_container_id}" -eq 64 ] || fail
  [ "$runtime_container_name" = "/$runtime_owner_container" ] || fail
  case "$runtime_container_status:$runtime_container_running" in created:false|running:true|exited:false) ;; *) fail ;; esac
  case "$runtime_container_exit_code" in ''|*[!0-9]*) fail ;; esac
  [ "$runtime_container_image" = "$runtime_owner_image" ] || fail
  [ "$runtime_container_label" = "$runtime_lock_digest" ] || fail
}

runtime_label_ids() {
  runtime_label_filter=$1
  runtime_label_output=$(docker_host ps -a --no-trunc --filter "$runtime_label_filter" --format '{{.ID}}') || fail
  case "$runtime_label_output" in *' '*|*'	'*) fail ;; esac
  case "$runtime_label_output" in *'
'*) fail ;; esac
  if [ -n "$runtime_label_output" ]; then
    case "$runtime_label_output" in *[!0-9a-f]*) fail ;; esac
    [ "${#runtime_label_output}" -eq 64 ] || fail
  fi
  printf '%s' "$runtime_label_output"
}

runtime_name_ids() {
  runtime_name_output=$(docker_host ps -a --no-trunc --filter "name=^/$runtime_owner_container$" --format '{{.ID}}') || fail
  case "$runtime_name_output" in *' '*|*'	'*) fail ;; esac
  case "$runtime_name_output" in *'
'*) fail ;; esac
  if [ -n "$runtime_name_output" ]; then
    case "$runtime_name_output" in *[!0-9a-f]*) fail ;; esac
    [ "${#runtime_name_output}" -eq 64 ] || fail
  fi
  printf '%s' "$runtime_name_output"
}

read_runtime_container_by_id() {
  runtime_reference=$1
  runtime_docker_daemon
  runtime_first=''
  runtime_first=$(runtime_docker_record "$runtime_reference") || {
    runtime_docker_daemon
    runtime_container_id=''
    runtime_container_running=''
    runtime_container_status=''
    runtime_container_exit_code=''
    return 0
  }
  runtime_validate_container_record "$runtime_first"
  [ "$runtime_container_id" = "$runtime_reference" ] || fail
  runtime_docker_daemon
}

read_runtime_bound_container_twice() {
  runtime_bound_read_id=$1
  read_runtime_container_by_id "$runtime_bound_read_id"
  runtime_bound_first=${runtime_first:-absent}
  runtime_bound_first_id=${runtime_container_id:-absent}
  read_runtime_container_by_id "$runtime_bound_read_id"
  runtime_bound_second=${runtime_first:-absent}
  [ "$runtime_bound_first" = "$runtime_bound_second" ] || fail
  [ "${runtime_container_id:-absent}" = "$runtime_bound_first_id" ] || fail
}

runtime_prestart_absent_once() {
  runtime_docker_daemon
  [ -z "$(runtime_label_ids 'label=uk.happybooking.runtime-lock-digest')" ] || fail
  [ -z "$(runtime_name_ids)" ] || fail
  runtime_docker_daemon
}

runtime_prestart_absent() {
  runtime_prestart_absent_once
  runtime_prestart_absent_once
}

prove_runtime_absent_once() {
  runtime_absent_id=$1
  runtime_docker_daemon
  if [ "$runtime_absent_id" != 'absent' ]; then
    read_runtime_container_by_id "$runtime_absent_id"
    [ -z "${runtime_container_id:-}" ] || fail
  fi
  [ -z "$(runtime_label_ids "label=uk.happybooking.runtime-lock-digest=$runtime_lock_digest")" ] || fail
  [ -z "$(runtime_name_ids)" ] || fail
  runtime_docker_daemon
}

prove_runtime_absent() {
  prove_runtime_absent_once "$1"
  prove_runtime_absent_once "$1"
}

sync_runtime_path() {
  "$SYNC" -f "$1" || fail
}

runtime_create_body() { printf '%s' "{\"containerId\":\"$runtime_created_id\",\"lockDigest\":\"$runtime_lock_digest\",\"schema\":\"booking.preprod-runtime-create/v1\"}"; }
runtime_create_document() { printf '%s\n' "{\"containerId\":\"$runtime_created_id\",\"createDigest\":\"$runtime_create_digest\",\"lockDigest\":\"$runtime_lock_digest\",\"schema\":\"booking.preprod-runtime-create/v1\"}"; }

publish_runtime_create() {
  runtime_create_digest=$(runtime_create_body | runtime_sha256)
  runtime_create_doc=$(runtime_create_document)
  runtime_publish_record "$runtime_txn/create.json" "$runtime_create_doc"
}

read_runtime_create() {
  runtime_create_file="$runtime_txn/create.json"
  [ -e "$runtime_create_file" ] || return 1
  runtime_created_id=$(runtime_json_string "$runtime_create_file" containerId)
  runtime_create_digest=$(runtime_json_string "$runtime_create_file" createDigest)
  runtime_create_lock=$(runtime_json_string "$runtime_create_file" lockDigest)
  case "$runtime_created_id" in *[!0-9a-f]*|'') fail ;; esac
  [ "${#runtime_created_id}" -eq 64 ] && [ "$runtime_create_lock" = "$runtime_lock_digest" ] || fail
  [ "$(runtime_create_body | runtime_sha256)" = "$runtime_create_digest" ] || fail
  runtime_create_doc=$(runtime_create_document)
  runtime_publish_record "$runtime_create_file" "$runtime_create_doc"
}

