    forwarded=" --action bind-existing --execute true --identity candidate --environment preprod --project booking-preprod --operation-id $operation_id --approval-id $approval_id --expected-generation $expected_generation --expected-fencing-epoch $expected_fencing_epoch --manifest-digest $manifest_digest --lease-id $lease_id --holder-id $holder_id --manifest $PREPROD_ROOT/releases/$release_id/release-manifest.json --backup-path $EVIDENCE_ROOT/backups/$operation_id.dump --expected-backup-digest $expected_backup_digest --receipt-path $EVIDENCE_ROOT/receipts/$operation_id-candidate-backup.json"
    ;;
  generate-schema-diff-receipt:generate)
    [ -n "$operation_id" ] && [ -n "$approval_id" ] && [ -n "$expected_generation" ] && [ -n "$expected_fencing_epoch" ] && [ -n "$manifest_digest" ] && [ -n "$lease_id" ] && [ -n "$holder_id" ] || fail
    forwarded=" --execute true --identity old --slot green --environment preprod --project booking-preprod --operation-id $operation_id --approval-id $approval_id --expected-generation $expected_generation --expected-fencing-epoch $expected_fencing_epoch --manifest-digest $manifest_digest --lease-id $lease_id --holder-id $holder_id --manifest $PREPROD_ROOT/releases/$LEGACY_RELEASE/release-manifest.json --receipt-path $EVIDENCE_ROOT/receipts/$operation_id-old-zero-diff.json"
    ;;
