#!/bin/sh
set -eu
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
IFS=' '
export PATH

IMAGE='node@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5'
HOST_DOCKER='/var/packages/ContainerManager/target/usr/bin/docker'
BUNDLE_ROOT='/volume1/happybooking/booking-preprod/.g4/control-plane-install/bundles'
EVIDENCE_TRUST_ROOT='/volume1/happybooking/booking-preprod/.g4'
RECEIPT_ROOT='/volume1/happybooking/booking-preprod/.g4/receipts'
STATE_PROJECT='/var/lib/happybooking/deploy-state/preprod/booking-preprod'
INSTALL_PARENT='/usr/local/libexec'
ACTIVE_ROOT='/usr/local/libexec/happybooking'
RUNTIME_LOCK='/usr/local/libexec/.happybooking-control-plane-runtime.lock'
INSTALL_LOCK='/usr/local/libexec/.happybooking-control-plane-install.lock'
INSTALL_JOURNAL='/usr/local/libexec/.happybooking-control-plane-install.journal.json'
MIGRATION_LOCK='/usr/local/libexec/.happybooking-legacy-active-migration.lock'
MIGRATION_JOURNAL='/usr/local/libexec/.happybooking-legacy-active-migration.journal.json'
COSIGN='/usr/local/bin/cosign'
COSIGN_TRUST_ROOT='/usr/local/bin'
APPROVER_KEY='/etc/happybooking/trust/control-plane-approver.pub'
APPROVER_KEY_ANCHOR='/etc/happybooking/trust/control-plane-approver.pub.sha256'
APPROVAL_ROOT='/volume1/happybooking/booking-preprod/.g4/control-plane-install/approvals'
APPROVER_TRUST_ROOT='/etc/happybooking'
HOST_IDENTITY='/etc/machine-id'
HOST_IDENTITY_TRUST_ROOT='/etc'
SELF='/usr/local/libexec/run-booking-preprod-control-plane-installer'
HOST_DOCKER_ENDPOINT='unix:///var/run/docker.sock'
HOST_DOCKER_CONFIG='/usr/local/libexec/.happybooking-host-docker-empty'
EXPECTED_UID='0'
EXPECTED_GID='0'
SHA256SUM='/usr/bin/sha256sum'
STAT='/usr/bin/stat'
READLINK='/usr/bin/readlink'
BOOTSTRAP_TEST='false'

fail() {
  printf '%s\n' 'booking-preprod control-plane installer launcher rejected the request' >&2
  exit 64
}

case "${BOOKING_CONTROL_PLANE_BOOTSTRAP_TEST_ROOT:-}" in
  '') ;;
  /*)
    [ "${BOOKING_CONTROL_PLANE_DRY_RUN:-}" = 'true' ] || fail
    case "$BOOKING_CONTROL_PLANE_BOOTSTRAP_TEST_ROOT" in *[!A-Za-z0-9._/-]*) fail ;; esac
    test_root=$("$READLINK" -f "$BOOKING_CONTROL_PLANE_BOOTSTRAP_TEST_ROOT") || fail
    [ "$test_root" = "$BOOKING_CONTROL_PLANE_BOOTSTRAP_TEST_ROOT" ] || fail
    BUNDLE_ROOT="$test_root/volume1/happybooking/booking-preprod/.g4/control-plane-install/bundles"
    EVIDENCE_TRUST_ROOT="$test_root/volume1/happybooking/booking-preprod/.g4"
    APPROVAL_ROOT="$test_root/volume1/happybooking/booking-preprod/.g4/control-plane-install/approvals"
    RECEIPT_ROOT="$test_root/volume1/happybooking/booking-preprod/.g4/receipts"
    STATE_PROJECT="$test_root/var/lib/happybooking/deploy-state/preprod/booking-preprod"
    INSTALL_PARENT="$test_root/usr/local/libexec"
    ACTIVE_ROOT="$INSTALL_PARENT/happybooking"
    RUNTIME_LOCK="$INSTALL_PARENT/.happybooking-control-plane-runtime.lock"
    INSTALL_LOCK="$INSTALL_PARENT/.happybooking-control-plane-install.lock"
    INSTALL_JOURNAL="$INSTALL_PARENT/.happybooking-control-plane-install.journal.json"
    MIGRATION_LOCK="$INSTALL_PARENT/.happybooking-legacy-active-migration.lock"
    MIGRATION_JOURNAL="$INSTALL_PARENT/.happybooking-legacy-active-migration.journal.json"
    COSIGN="$test_root/usr/local/bin/cosign"
    COSIGN_TRUST_ROOT="$test_root/usr/local/bin"
    APPROVER_KEY="$test_root/etc/happybooking/trust/control-plane-approver.pub"
    APPROVER_KEY_ANCHOR="$test_root/etc/happybooking/trust/control-plane-approver.pub.sha256"
    APPROVER_TRUST_ROOT="$test_root/etc/happybooking"
    HOST_IDENTITY="$test_root/etc/machine-id"
    HOST_IDENTITY_TRUST_ROOT="$test_root/etc"
    SELF="$INSTALL_PARENT/run-booking-preprod-control-plane-installer"
    HOST_DOCKER_CONFIG="$INSTALL_PARENT/.happybooking-host-docker-empty"
    EXPECTED_UID=$(id -u)
    EXPECTED_GID=$(id -g)
    BOOTSTRAP_TEST='true'
    ;;
  *) fail ;;
esac

# The host client must never inherit a caller-selected daemon, context, TLS
# identity, API downgrade, registry configuration, platform, or dynamic-loader
# path. Global CLI flags repeat the endpoint/config binding at every invocation.
DOCKER_HOST=$HOST_DOCKER_ENDPOINT
DOCKER_CONFIG=$HOST_DOCKER_CONFIG
unset DOCKER_CONTEXT DOCKER_TLS DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_API_VERSION \
  DOCKER_AUTH_CONFIG DOCKER_CUSTOM_HEADERS DOCKER_CONTENT_TRUST \
  DOCKER_CONTENT_TRUST_SERVER DOCKER_DEFAULT_PLATFORM LD_PRELOAD LD_LIBRARY_PATH
export DOCKER_HOST DOCKER_CONFIG

not_writable_by_group_or_other() {
  mode=$1
  group_digit=$(( (mode / 10) % 10 ))
  other_digit=$(( mode % 10 ))
  case "$group_digit:$other_digit" in *2*|*3*|*6*|*7*) return 1 ;; esac
  return 0
}

trusted_item() {
  item=$1
  [ -e "$item" ] && [ ! -L "$item" ] || fail
  [ "$("$READLINK" -f "$item")" = "$item" ] || fail
  metadata=$("$STAT" -c '%u %g %a %h' "$item") || fail
  set -- $metadata
  [ "$1" = "$EXPECTED_UID" ] && [ "$2" = "$EXPECTED_GID" ] || fail
  not_writable_by_group_or_other "$3" || fail
  [ "${#3}" -le 3 ] || fail
  if [ -f "$item" ] && [ ! -d "$item" ]; then [ "$4" = '1' ] || fail; fi
}

trusted_chain() {
  item=$1
  root=$2
  current=$item
  while :; do
    trusted_item "$current"
    [ "$current" = "$root" ] && break
    parent=$(dirname "$current")
    [ "$parent" != "$current" ] || fail
    current=$parent
  done
}

host_docker_boundary() {
  [ "$DOCKER_HOST" = "$HOST_DOCKER_ENDPOINT" ] || fail
  [ "$DOCKER_CONFIG" = "$HOST_DOCKER_CONFIG" ] || fail
  [ "$(dirname "$HOST_DOCKER_CONFIG")" = "$INSTALL_PARENT" ] || fail
  path_absent "$HOST_DOCKER_CONFIG"
  trusted_item "$INSTALL_PARENT"
}

path_absent() {
  [ ! -e "$1" ] && [ ! -L "$1" ] || fail
}

host_docker() {
  host_docker_boundary
  "$HOST_DOCKER" --host "$HOST_DOCKER_ENDPOINT" --config "$HOST_DOCKER_CONFIG" "$@"
}

host_docker_exec() {
  host_docker_boundary
  exec "$HOST_DOCKER" --host "$HOST_DOCKER_ENDPOINT" --config "$HOST_DOCKER_CONFIG" "$@"
}

json_string() {
  file=$1
  field=$2
  value=$(sed -n "s/.*\"$field\":\"\([^\"]*\)\".*/\1/p" "$file")
  [ -n "$value" ] && case "$value" in *'\n'*) return 1 ;; esac
  printf '%s' "$value"
}

canonical_body_digest() {
  file=$1
  field=$2
  body=$(sed "s/,\"$field\":\"sha256:[0-9a-f]\{64\}\"//" "$file")
  [ "$body" != "$(cat "$file")" ] || fail
  printf '%s' "$body" | "$SHA256SUM" | awk '{printf "sha256:%s", $1}'
}

valid_install_id() {
  candidate=$1
  case "$candidate" in booking-control-*) ;; *) return 1 ;; esac
  tail=${candidate#booking-control-}; date_part=${tail%%T*}; rest=${tail#*T}; time_part=${rest%%Z-*}; sha_part=${rest#*Z-}
  [ "$candidate" = "booking-control-${date_part}T${time_part}Z-${sha_part}" ] || return 1
  [ "${#date_part}" -eq 8 ] && [ "${#time_part}" -eq 6 ] && [ "${#sha_part}" -eq 12 ] || return 1
  case "$date_part$time_part" in *[!0-9]*) return 1 ;; esac
  case "$sha_part" in *[!0-9a-f]*) return 1 ;; esac
}

[ "$#" -ge 4 ] || fail
action=''
install_id=''
git_sha=''
approval_id=''
migration_id=''
expected_raw_inventory_digest=''
expected_normalized_inventory_digest=''
predecessor_receipt_digest=''
execute=''
transaction_id=''
seen=' '
allowed=' action install-id git-sha approval-id source-archive-digest installer-digest bundle-declaration-digest tracked-allowlist-digest expected-inventory-digest expected-active-inventory-digest approval-tuple-digest approver-receipt-digest expected-receipt-digest rollback-id expected-rollback-inventory-digest transaction-id migration-id expected-raw-inventory-digest expected-normalized-inventory-digest predecessor-receipt-digest execute '
original="$*"
while [ "$#" -gt 0 ]; do
  option=$1; shift
  case "$option" in --*) key=${option#--} ;; *) fail ;; esac
  case "$allowed" in *" $key "*) ;; *) fail ;; esac
  case "$seen" in *" $key "*) fail ;; esac
  [ "$#" -gt 0 ] || fail
  value=$1; shift
  [ -n "$value" ] || fail
  case "$value" in --*|*[!A-Za-z0-9._:@-]*) fail ;; esac
  seen="$seen$key "
  case "$key" in
    action) action=$value ;; install-id) install_id=$value ;; git-sha) git_sha=$value ;; approval-id) approval_id=$value ;;
    migration-id) migration_id=$value ;; expected-raw-inventory-digest) expected_raw_inventory_digest=$value ;;
    expected-normalized-inventory-digest) expected_normalized_inventory_digest=$value ;; predecessor-receipt-digest) predecessor_receipt_digest=$value ;; execute) execute=$value ;; transaction-id) transaction_id=$value ;;
  esac
done

case "$action" in active-inventory|inventory|install|readback|rollback|recover|legacy-inventory|legacy-migrate|legacy-recover|legacy-rollback) ;; *) fail ;; esac
case "$action" in
  active-inventory|inventory) action_allowed=' action install-id git-sha approval-id ' ;;
  install) action_allowed=' action install-id git-sha approval-id source-archive-digest installer-digest bundle-declaration-digest tracked-allowlist-digest expected-inventory-digest approval-tuple-digest approver-receipt-digest ' ;;
  readback) action_allowed=' action install-id expected-receipt-digest ' ;;
  rollback) action_allowed=' action install-id git-sha approval-id rollback-id expected-active-inventory-digest expected-rollback-inventory-digest ' ;;
  recover) action_allowed=' action install-id git-sha approval-id transaction-id ' ;;
  legacy-inventory) action_allowed=' action install-id git-sha approval-id migration-id ' ;;
  legacy-migrate) action_allowed=' action install-id git-sha approval-id migration-id transaction-id expected-raw-inventory-digest execute ' ;;
  legacy-recover) action_allowed=' action install-id git-sha approval-id migration-id transaction-id expected-normalized-inventory-digest predecessor-receipt-digest execute ' ;;
  legacy-rollback) action_allowed=' action install-id git-sha approval-id migration-id transaction-id expected-raw-inventory-digest expected-normalized-inventory-digest predecessor-receipt-digest execute ' ;;
esac
for used_key in $seen; do case "$action_allowed" in *" $used_key "*) ;; *) fail ;; esac; done
valid_install_id "$install_id" || fail
case "$action" in
  legacy-migrate|legacy-recover|legacy-rollback)
    path_absent "$RUNTIME_LOCK"
    path_absent "$INSTALL_LOCK"
    path_absent "$INSTALL_JOURNAL"
    ;;
esac
installer="$BUNDLE_ROOT/$install_id/installer.mjs"
migrator="$BUNDLE_ROOT/$install_id/payload/control-plane/ops/release/migrate-booking-preprod-legacy-active-root.mjs"
approval_dir="$APPROVAL_ROOT/$install_id"
approval_tuple="$approval_dir/approval-tuple.json"
approver_receipt="$approval_dir/approver-receipt.json"
approver_signature="$approval_dir/approver-receipt.sig"

# This bootstrap verification is deliberately host-side and precedes both the
# real Docker call and dry-run output. The signed tuple therefore binds the
# launcher bytes that select IMAGE and construct the container boundary.
[ "$("$READLINK" -f "$0")" = "$SELF" ] || fail
trusted_chain "$SELF" "$INSTALL_PARENT"
[ -x "$SELF" ] || fail
trusted_chain "$BUNDLE_ROOT" "$EVIDENCE_TRUST_ROOT"
trusted_chain "$BUNDLE_ROOT/$install_id" "$BUNDLE_ROOT"
trusted_item "$installer"
trusted_chain "$APPROVAL_ROOT" "$EVIDENCE_TRUST_ROOT"
trusted_chain "$approval_dir" "$APPROVAL_ROOT"
trusted_item "$approval_tuple"
if [ "$BOOTSTRAP_TEST" = 'false' ]; then
  trusted_chain "$SHA256SUM" '/usr/bin'
  trusted_chain "$STAT" '/usr/bin'
  trusted_chain "$READLINK" '/usr/bin'
fi
host_docker_boundary

tuple_digest=$(json_string "$approval_tuple" 'tupleDigest') || fail
[ "$tuple_digest" = "$(canonical_body_digest "$approval_tuple" 'tupleDigest')" ] || fail
[ "$(json_string "$approval_tuple" 'schema')" = 'booking.preprod-control-plane-approval-tuple/v1' ] || fail
[ "$(json_string "$approval_tuple" 'status')" = 'awaiting-independent-approval' ] || fail
[ "$(json_string "$approval_tuple" 'installId')" = "$install_id" ] || fail
tuple_git_sha=$(json_string "$approval_tuple" 'gitSha') || fail
[ -z "$git_sha" ] || [ "$tuple_git_sha" = "$git_sha" ] || fail
tuple_approval_id=$(json_string "$approval_tuple" 'approvalId') || fail
[ -z "$approval_id" ] || [ "$tuple_approval_id" = "$approval_id" ] || fail
launcher_digest=$(json_string "$approval_tuple" 'bootstrapInstallerLauncherDigest') || fail
[ "$launcher_digest" = "sha256:$("$SHA256SUM" "$SELF" | awk '{print $1}')" ] || fail
tuple_installer_digest=$(json_string "$approval_tuple" 'installerDigest') || fail
[ "$tuple_installer_digest" = "sha256:$("$SHA256SUM" "$installer" | awk '{print $1}')" ] || fail

case "$action" in
legacy-inventory|legacy-migrate|legacy-recover|legacy-rollback)
  case "$migration_id" in booking-legacy-active-????????T??????Z-????????????) ;; *) fail ;; esac
  case "$migration_id" in *[!A-Za-z0-9._-]*) fail ;; esac
  [ -z "$execute" ] || [ "$execute" = 'true' ] || fail
  trusted_item "$migrator"
  trusted_chain "$RECEIPT_ROOT" "$EVIDENCE_TRUST_ROOT"

  # First make the reviewed installer recompute the complete bundle declaration
  # and payload inventory. The migration script is consumed only after this
  # preflight succeeds; immutable root-owned bundle parents close the TOCTOU gap.
  set -- run --rm --pull never --name booking-preprod-legacy-bundle-preflight \
    --network none --user 0:0 --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=16m \
    --env HOME=/root --env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    --env NODE_OPTIONS= --env NODE_PATH= --env LD_PRELOAD= \
    --mount type=bind,src="$BUNDLE_ROOT/$install_id",dst="$BUNDLE_ROOT/$install_id",readonly \
    --workdir "$BUNDLE_ROOT/$install_id" --entrypoint /usr/local/bin/node \
    "$IMAGE" "$installer" --action bundle-inventory --install-id "$install_id" --git-sha "$git_sha" --approval-id "$approval_id"
  case "${BOOKING_CONTROL_PLANE_DRY_RUN:-}" in
    true) printf '%s\n' LEGACY_BUNDLE_PREFLIGHT "$HOST_DOCKER" --host "$HOST_DOCKER_ENDPOINT" --config "$HOST_DOCKER_CONFIG" "$@" ;;
    '') [ "$(id -u)" = '0' ] || fail; [ -x "$HOST_DOCKER" ] || fail; host_docker "$@" >/dev/null || fail ;;
    *) fail ;;
  esac

  case "$action" in
    legacy-inventory)
      set -- --action inventory --migration-id "$migration_id" --approval-id "$approval_id"
      migration_mount_suffix=',readonly'; migration_name='booking-preprod-legacy-active-inventory'; migration_caps='false'
      ;;
    legacy-migrate)
      [ "$execute" = 'true' ] || fail
      case "$transaction_id" in ????????-????-????-????-????????????) ;; *) fail ;; esac
      case "$expected_raw_inventory_digest" in sha256:????????????????????????????????????????????????????????????????) ;; *) fail ;; esac
      set -- --action migrate --migration-id "$migration_id" --approval-id "$approval_id" --transaction-id "$transaction_id" --expected-raw-inventory-digest "$expected_raw_inventory_digest" --execute true
      migration_mount_suffix=''; migration_name='booking-preprod-legacy-active-migration'; migration_caps='true'
      ;;
    legacy-recover)
      [ "$execute" = 'true' ] || fail
      case "$transaction_id" in ????????-????-????-????-????????????) ;; *) fail ;; esac
      case "$predecessor_receipt_digest:$expected_normalized_inventory_digest" in
        :) ;;
        sha256:????????????????????????????????????????????????????????????????:sha256:????????????????????????????????????????????????????????????????) ;;
        *) fail ;;
      esac
      set -- --action recover --migration-id "$migration_id" --approval-id "$approval_id" --transaction-id "$transaction_id" --execute true
      migration_mount_suffix=''; migration_name='booking-preprod-legacy-active-migration-recovery'; migration_caps='true'
      ;;
    legacy-rollback)
      [ "$execute" = 'true' ] || fail
      case "$transaction_id" in ????????-????-????-????-????????????) ;; *) fail ;; esac
      case "$expected_raw_inventory_digest:$expected_normalized_inventory_digest" in sha256:????????????????????????????????????????????????????????????????:sha256:????????????????????????????????????????????????????????????????) ;; *) fail ;; esac
      case "$predecessor_receipt_digest" in sha256:????????????????????????????????????????????????????????????????) ;; *) fail ;; esac
      set -- --action rollback --migration-id "$migration_id" --approval-id "$approval_id" --transaction-id "$transaction_id" --expected-raw-inventory-digest "$expected_raw_inventory_digest" --expected-normalized-inventory-digest "$expected_normalized_inventory_digest" --predecessor-receipt-digest "$predecessor_receipt_digest" --execute true
      migration_mount_suffix=''; migration_name='booking-preprod-legacy-active-migration'; migration_caps='true'
      ;;
  esac
  case "$action" in
    legacy-inventory) migration_args="--action inventory --migration-id $migration_id --approval-id $approval_id" ;;
    legacy-migrate) migration_args="--action migrate --migration-id $migration_id --approval-id $approval_id --transaction-id $transaction_id --expected-raw-inventory-digest $expected_raw_inventory_digest --execute true" ;;
    legacy-recover) migration_args="--action recover --migration-id $migration_id --approval-id $approval_id --transaction-id $transaction_id${predecessor_receipt_digest:+ --predecessor-receipt-digest $predecessor_receipt_digest}${expected_normalized_inventory_digest:+ --expected-normalized-inventory-digest $expected_normalized_inventory_digest} --execute true" ;;
    legacy-rollback) migration_args="--action rollback --migration-id $migration_id --approval-id $approval_id --transaction-id $transaction_id --expected-raw-inventory-digest $expected_raw_inventory_digest --expected-normalized-inventory-digest $expected_normalized_inventory_digest --predecessor-receipt-digest $predecessor_receipt_digest --execute true" ;;
  esac
  if [ "$migration_caps" = 'false' ]; then
    set -- run --rm --pull never --name "$migration_name" --network none --user 0:0 --read-only --cap-drop ALL \
      --security-opt no-new-privileges:true --tmpfs /tmp:rw,nosuid,nodev,noexec,size=16m \
      --env HOME=/root --env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --env NODE_OPTIONS= --env NODE_PATH= --env LD_PRELOAD= \
      --mount type=bind,src="$BUNDLE_ROOT/$install_id",dst="$BUNDLE_ROOT/$install_id",readonly \
      --mount type=bind,src="$INSTALL_PARENT",dst="$INSTALL_PARENT",readonly \
      --mount type=bind,src="$RECEIPT_ROOT",dst="$RECEIPT_ROOT",readonly \
      --workdir "$BUNDLE_ROOT/$install_id" --entrypoint /usr/local/bin/node "$IMAGE" "$migrator" $migration_args
    case "${BOOKING_CONTROL_PLANE_DRY_RUN:-}" in
      true) printf '%s\n' LEGACY_MIGRATION "$HOST_DOCKER" --host "$HOST_DOCKER_ENDPOINT" --config "$HOST_DOCKER_CONFIG" "$@"; exit 0 ;;
      '') ;;
      *) fail ;;
    esac
    [ "$(id -u)" = '0' ] && [ -x "$HOST_DOCKER" ] || fail
    host_docker_exec "$@"
  fi
  legacy_pending='true'
  ;;
esac

if [ "$action" = 'active-inventory' ]; then
  trusted_chain "$ACTIVE_ROOT" "$INSTALL_PARENT"
  trusted_chain "$HOST_IDENTITY" "$HOST_IDENTITY_TRUST_ROOT"
  set -- $original
  set -- run --rm --pull never --name booking-preprod-control-plane-active-inventory \
    --network none --user 0:0 --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=16m \
    --env HOME=/root --env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    --env NODE_OPTIONS= --env NODE_PATH= --env LD_PRELOAD= \
    --mount type=bind,src="$BUNDLE_ROOT/$install_id",dst="$BUNDLE_ROOT/$install_id",readonly \
    --mount type=bind,src="$ACTIVE_ROOT",dst=/usr/local/libexec/happybooking,readonly \
    --mount type=bind,src="$HOST_IDENTITY",dst=/etc/machine-id,readonly \
    --workdir "$BUNDLE_ROOT/$install_id" --entrypoint /usr/local/bin/node \
    "$IMAGE" "$installer" "$@"
  case "${BOOKING_CONTROL_PLANE_DRY_RUN:-}" in
    true) printf '%s\n' "$HOST_DOCKER" --host "$HOST_DOCKER_ENDPOINT" --config "$HOST_DOCKER_CONFIG" "$@"; exit 0 ;;
    '') ;;
    *) fail ;;
  esac
  [ "$(id -u)" = '0' ] || fail
  [ -x "$HOST_DOCKER" ] || fail
  host_docker_exec "$@"
fi

trusted_item "$approver_receipt"
trusted_item "$approver_signature"
trusted_chain "$COSIGN" "$COSIGN_TRUST_ROOT"
[ -x "$COSIGN" ] || fail
trusted_chain "$APPROVER_KEY" "$APPROVER_TRUST_ROOT"
trusted_item "$APPROVER_KEY_ANCHOR"
if [ "$BOOTSTRAP_TEST" = 'false' ]; then
  case "$(uname -m)" in
    x86_64) expected_cosign='f7622ed3cf22e55e1ae6377c080979ff77a22da9981c11df222a2e444991e7cf' ;;
    aarch64|arm64) expected_cosign='90e7ae0b5dfd60f20816b52c012addf7fc055ebcc7bea4ce81c428ca8518c302' ;;
    *) fail ;;
  esac
  [ "$("$SHA256SUM" "$COSIGN" | awk '{print $1}')" = "$expected_cosign" ] || fail
fi
receipt_git_sha=$(json_string "$approver_receipt" 'gitSha') || fail
[ "$tuple_git_sha" = "$receipt_git_sha" ] || fail
receipt_approval_id=$(json_string "$approver_receipt" 'approvalId') || fail
[ "$tuple_approval_id" = "$receipt_approval_id" ] || fail

receipt_digest=$(json_string "$approver_receipt" 'receiptDigest') || fail
[ "$receipt_digest" = "$(canonical_body_digest "$approver_receipt" 'receiptDigest')" ] || fail
receipt_schema=$(json_string "$approver_receipt" 'schema') || fail
case "$receipt_schema:$action" in
  booking.preprod.control-plane-approval-receipt/v3:legacy-migrate|booking.preprod.control-plane-approval-receipt/v3:legacy-recover|booking.preprod.control-plane-approval-receipt/v3:legacy-rollback) ;;
  booking.preprod.control-plane-approval-receipt/v2:legacy-*) fail ;;
  booking.preprod.control-plane-approval-receipt/v2:*) ;;
  *) fail ;;
esac
[ "$(json_string "$approver_receipt" 'status')" = 'approved' ] || fail
[ "$(json_string "$approver_receipt" 'environment')" = 'preprod' ] || fail
[ "$(json_string "$approver_receipt" 'project')" = 'booking-preprod' ] || fail
[ "$(json_string "$approver_receipt" 'installId')" = "$install_id" ] || fail
[ "$(json_string "$approver_receipt" 'tupleDigest')" = "$tuple_digest" ] || fail
public_key_digest=$(json_string "$approver_receipt" 'publicKeyDigest') || fail
